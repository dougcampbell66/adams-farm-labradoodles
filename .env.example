# ─── PuppyQ database (Supabase) ─────────────────────────────────────────────
#
# Powers the LIVE data on /our-dogs, /our-litters, and /our-puppies. Without
# these, those pages render empty ("coming soon"). MUST be set both locally
# (.env.local) AND in Vercel → Settings → Environment Variables (Production +
# Preview). Check any environment at /api/puppyq/health.
#
# NEXT_PUBLIC_SUPABASE_URL         — the project URL, e.g. https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY        — server-only secret key (bypasses RLS).
#                                    NEVER expose to the browser or commit it.
# NEXT_PUBLIC_SUPABASE_ANON_KEY    — optional publishable fallback (anon-policy rows only).
# ADAMS_FARM_ORG_ID                — optional. Pin the organization id instead of
#                                    resolving it by name ("Adams Farm Labradoodles").
#
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# ADAMS_FARM_ORG_ID=

# ─── Contact form (Hostinger SMTP) ──────────────────────────────────────────
#
# Use your existing Hostinger email account credentials.
# In Vercel: Settings → Environment Variables → add both values below.
#
# SMTP_EMAIL    — the full Hostinger email address (e.g. hello@adamsfarmlabradoodles.com)
# SMTP_PASSWORD — the password for that email account
#
# Hostinger SMTP settings (already hardcoded in the API route):
#   Host: smtp.hostinger.com
#   Port: 465
#   Secure: true (SSL)
#
SMTP_EMAIL=puppy@adamsfarmlabradoodles.com
SMTP_PASSWORD=your-hostinger-email-password

# ─── Magic link auth ─────────────────────────────────────────────────────────
#
# MAGIC_LINK_SECRET  — random secret used to sign login + session tokens.
#                      Generate one with: openssl rand -base64 32
#                      Rotating this invalidates all outstanding links and cookies.
#
# ADAMS_FARM_ALLOWED_EMAILS — comma-separated list of addresses that may access
#                             /forever-families. Removing an address locks them
#                             out immediately (checked on every request).
#                             Example: jane@example.com,bob@example.com
#
# RESEND_API_KEY     — API key for sending magic link emails.
#                      Create one at resend.com/api-keys.
#                      Without this, dev mode prints the link to the terminal instead.
#
# AUTH_EMAIL_FROM    — Optional. Verified sending address once you've set up a
#                      domain at resend.com/domains.
#                      Example: Adams Farm Labradoodles <noreply@adamsfarmlabradoodles.com>
#                      Defaults to onboarding@resend.dev (Resend account owner only).
#
MAGIC_LINK_SECRET=your-random-secret-here
ADAMS_FARM_ALLOWED_EMAILS=you@example.com
RESEND_API_KEY=re_your_key_here
# AUTH_EMAIL_FROM=Adams Farm Labradoodles <noreply@adamsfarmlabradoodles.com>
